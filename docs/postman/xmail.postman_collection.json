{
  "info": {
    "name": "xmail REST API",
    "description": "Complete Postman collection for the xmail REST API (email-as-a-service: send & receive email via REST + MCP).\n\nHow to use:\n1. Also import the `xmail.postman_environment.json` environment, then select the 'xmail (local)' environment.\n2. Set the `apiKey` environment variable to the server's `XMAIL_API_KEY`.\n3. Run 'Health / Healthz' to confirm the server is up.\n4. Run 'Accounts / Create Account' — its test script fills `accountId` automatically, so the other {id} requests are immediately ready.\n5. Run requests in folder order: Health -> Accounts -> Mail. The 'Errors' folder holds failure scenarios (401/400/404).\n\nEvery response uses the {\"data\": ..., \"error\": null} envelope. Full documentation: docs/API.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5569", "type": "string" },
    { "key": "apiKey", "value": "changeme", "type": "string" },
    { "key": "accountId", "value": "", "type": "string" },
    { "key": "messageUid", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Warn if apiKey is not set.",
          "if (!pm.environment.get('apiKey')) {",
          "  console.warn('apiKey environment variable is not set — fill it to match the server XMAIL_API_KEY.');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every endpoint (including errors) uses the {data, error} envelope.",
          "pm.test('response uses the {data, error} envelope', function () {",
          "  pm.response.to.be.json;",
          "  const body = pm.response.json();",
          "  pm.expect(body).to.have.property('data');",
          "  pm.expect(body).to.have.property('error');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Healthz (no auth)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/healthz", "host": ["{{baseUrl}}"], "path": ["healthz"] },
            "description": "Health check. Does NOT require auth — used by an orchestrator (Docker/k8s) as a liveness probe.\n\nResponse 200: {\"data\":{\"status\":\"ok\"},\"error\":null}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().data.status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('response does not leak credentials', () => {",
                  "  pm.expect(body.data).to.not.have.property('password');",
                  "  pm.expect(body.data).to.not.have.property('encrypted_secret');",
                  "});",
                  "if (body.data && body.data.id) {",
                  "  pm.environment.set('accountId', body.data.id);",
                  "  console.log('accountId =', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gmail Work\",\n  \"email\": \"me@example.com\",\n  \"username\": \"me@example.com\",\n  \"password\": \"app-password-here\",\n  \"smtp\": { \"host\": \"smtp.gmail.com\", \"port\": 587, \"tls_mode\": \"starttls\" },\n  \"imap\": { \"host\": \"imap.gmail.com\", \"port\": 993, \"tls_mode\": \"tls\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "description": "Create a new email account. The password is encrypted immediately (AES-256-GCM).\n\nFields: name, email, username (required); password (required on create); at least one of smtp/imap/pop3, each conn: {host, port, tls_mode}.\ntls_mode: \"tls\" | \"starttls\" | \"none\" (POP3 does not support \"starttls\").\n\nResponse 201: accountResponse WITHOUT credentials. Fills the `accountId` environment variable."
          }
        },
        {
          "name": "Create Account (IMAP-only, minimal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('smtp & pop3 null', () => {",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d.smtp).to.eql(null);",
                  "  pm.expect(d.pop3).to.eql(null);",
                  "  pm.expect(d.imap).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Read-only IMAP\",\n  \"email\": \"me@example.com\",\n  \"username\": \"me@example.com\",\n  \"password\": \"app-password-here\",\n  \"imap\": { \"host\": \"imap.example.com\", \"port\": 993, \"tls_mode\": \"tls\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "description": "Example IMAP-only account (no smtp/pop3). Shows that a single protocol is enough.\n\nNote: sending from this account will fail (no smtp configuration)."
          }
        },
        {
          "name": "Create Account (invalid — expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error.code validation_failed', () => pm.expect(pm.response.json().error.code).to.eql('validation_failed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Empty\",\n  \"email\": \"me@example.com\",\n  \"username\": \"me@example.com\",\n  \"password\": \"pw\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "description": "Failure scenario: none of the protocols (smtp/imap/pop3) is configured.\n\nExpected: 400 validation_failed: at least one of smtp, imap, pop3 must be configured."
          }
        },
        {
          "name": "Create Account (POP3 starttls — expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad POP3\",\n  \"email\": \"me@example.com\",\n  \"username\": \"me@example.com\",\n  \"password\": \"pw\",\n  \"pop3\": { \"host\": \"pop.example.com\", \"port\": 110, \"tls_mode\": \"starttls\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "description": "Failure scenario: POP3 does not support tls_mode starttls (the POP3 library used has no STARTTLS).\n\nExpected: 400 validation_failed."
          }
        },
        {
          "name": "List Accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "description": "List all accounts (without credentials), sorted by name.\n\nResponse 200: {\"data\":[accountResponse,...],\"error\":null} — may be []."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}"]
            },
            "description": "Details of one account by id (from the `accountId` environment variable).\n\nResponse 200: accountResponse. 404 not_found if the id does not exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('matching id', () => pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('accountId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Account (rename, keep password)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gmail (renamed)\",\n  \"email\": \"me@example.com\",\n  \"username\": \"me@example.com\",\n  \"smtp\": { \"host\": \"smtp.gmail.com\", \"port\": 587, \"tls_mode\": \"starttls\" },\n  \"imap\": { \"host\": \"imap.gmail.com\", \"port\": 993, \"tls_mode\": \"tls\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}"]
            },
            "description": "Update an account. `password` is NOT sent here -> the old credentials are kept.\n\nIMPORTANT: PUT = full replace. Any smtp/imap/pop3 field not sent is nulled out. This example sends smtp & imap but not pop3 -> pop3 becomes null.\n\nResponse 200: accountResponse."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('pop3 becomes null (full replace)', () => pm.expect(pm.response.json().data.pop3).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Account (change password)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gmail (renamed)\",\n  \"email\": \"me@example.com\",\n  \"username\": \"me@example.com\",\n  \"password\": \"new-app-password\",\n  \"imap\": { \"host\": \"imap.gmail.com\", \"port\": 993, \"tls_mode\": \"tls\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}"]
            },
            "description": "Update with a non-null `password` -> the credentials are replaced and re-encrypted.\n\nNote: this example sends only `imap`, so smtp & pop3 become null (full replace)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('does not leak password', () => pm.expect(pm.response.json().data).to.not.have.property('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Test Connection (SMTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"protocol\": \"smtp\" }", "options": { "raw": { "language": "json" } } },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/test-connection",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "test-connection"]
            },
            "description": "Test SMTP connection + authentication without side effects.\n\nResponse 200: {\"data\":{\"ok\":true},\"error\":null}. Failed connect/auth -> 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Test Connection (IMAP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"protocol\": \"imap\" }", "options": { "raw": { "language": "json" } } },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/test-connection",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "test-connection"]
            },
            "description": "Test IMAP connection + authentication without side effects.\n\nResponse 200: {\"data\":{\"ok\":true},\"error\":null}."
          }
        },
        {
          "name": "Test Connection (POP3)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"protocol\": \"pop3\" }", "options": { "raw": { "language": "json" } } },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/test-connection",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "test-connection"]
            },
            "description": "Test POP3 connection + authentication without side effects. An account with no pop3 configuration -> 400 validation_failed."
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}"]
            },
            "description": "Delete an account (cascades to credentials & messages_cache).\n\nResponse 200: {\"data\":{\"deleted\":true},\"error\":null} — NOT 204."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 (not 204)', () => pm.response.to.have.status(200));",
                  "pm.test('deleted true', () => pm.expect(pm.response.json().data.deleted).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Account After Delete (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}"]
            },
            "description": "Verify the account is really gone.\n\nExpected: 404 not_found. (Run after 'Delete Account'.)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error.code not_found', () => pm.expect(pm.response.json().error.code).to.eql('not_found'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Mail",
      "item": [
        {
          "name": "Send Email (plain text)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": [\"bob@example.com\"],\n  \"subject\": \"Hello from xmail\",\n  \"body_text\": \"Test message from Postman.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/send",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "send"]
            },
            "description": "Send a plain-text email. From = account.email (set automatically).\n\nResponse 200: {\"data\":{\"status\":\"sent\"},\"error\":null}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('sent', () => pm.expect(pm.response.json().data.status).to.eql('sent'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send Email (HTML + attachment + headers + cc/bcc)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": [\"bob@example.com\"],\n  \"cc\": [\"carol@example.com\"],\n  \"bcc\": [\"dave@example.com\"],\n  \"subject\": \"Monthly report\",\n  \"body_text\": \"Report attached.\",\n  \"body_html\": \"<p>Report <b>attached</b>.</p>\",\n  \"headers\": { \"X-Priority\": \"1\", \"Reply-To\": \"reply@example.com\" },\n  \"attachments\": [\n    { \"filename\": \"report.txt\", \"content_type\": \"text/plain\", \"data_base64\": \"SGVsbG8sIHhtYWlsIQ==\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/send",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "send"]
            },
            "description": "Send a full email: HTML + plain-text (becomes multipart/alternative), cc/bcc, custom headers, and an attachment.\n\ndata_base64 = the file contents in base64 (example: 'SGVsbG8sIHhtYWlsIQ==' = 'Hello, xmail!').\nNote: content_type is currently unused; the attachment's MIME type is detected from the filename."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Send Email (no recipients — expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error.code validation_failed', () => pm.expect(pm.response.json().error.code).to.eql('validation_failed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"no recipients\",\n  \"body_text\": \"fails\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/send",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "send"]
            },
            "description": "Failure scenario: `to` is empty.\n\nExpected: 400 validation_failed: to is required."
          }
        },
        {
          "name": "Fetch Messages (cache-first)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/messages?protocol=imap&folder=INBOX&limit=20&offset=0&refresh=false",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "messages"],
              "query": [
                { "key": "protocol", "value": "imap", "description": "imap | pop3" },
                { "key": "folder", "value": "INBOX", "description": "IMAP folder (POP3 is always INBOX)" },
                { "key": "limit", "value": "20", "description": "max number of messages (<=0 -> default 20)" },
                { "key": "offset", "value": "0", "description": "skip the N newest messages" },
                { "key": "refresh", "value": "false", "description": "true/1 = force a live fetch" }
              ]
            },
            "description": "Fetch the email list (metadata only). Cache-first: if the local cache already covers the window, it does not dial the server. A second request with the same window is usually a cache hit.\n\nResponse 200: {\"data\":[Message,...],\"error\":null}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "const d = pm.response.json().data;",
                  "if (d && d.length > 0 && d[0].uid) { pm.environment.set('messageUid', d[0].uid); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Fetch Messages (refresh / live)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/messages?refresh=true&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "messages"],
              "query": [
                { "key": "refresh", "value": "true", "description": "force a live dial" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Force a live fetch from the server, ignoring the cache — to guarantee the freshest data."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "if (d && d.length > 0 && d[0].uid) { pm.environment.set('messageUid', d[0].uid); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Fetch Messages (POP3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/messages?protocol=pop3&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "messages"],
              "query": [
                { "key": "protocol", "value": "pop3" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Fetch via POP3. Note: the folder is always INBOX, is_read is always true, attachments are always empty (POP3 has no flag/body structure)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Check New Emails",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"protocol\": \"imap\",\n  \"folder\": \"INBOX\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/check",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "check"]
            },
            "description": "Check for new email. ALWAYS dials the server (not the cache), then updates the cache for the 50 newest messages.\n\nBody: {protocol?, folder?} (default imap/INBOX).\nResponse 200: {\"data\":{\"unread_count\":5,\"new_count\":2},\"error\":null}\n- unread_count: reported by the server (IMAP only; POP3 = 0)\n- new_count: from the 50 newest messages not yet in the cache"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('has unread_count & new_count', () => {",
                  "  pm.expect(d).to.have.property('unread_count');",
                  "  pm.expect(d).to.have.property('new_count');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark Message Read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"protocol\": \"imap\",\n  \"folder\": \"INBOX\",\n  \"uid\": \"{{messageUid}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/messages/read",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "messages", "read"]
            },
            "description": "Mark one message as read (sets the \\Seen flag). IMAP-only; POP3 -> 400.\n\n`uid` is filled from `messageUid` (set automatically by the Fetch Messages request).\nResponse 200: {\"data\":{\"marked_read\":true},\"error\":null}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('marked_read true', () => pm.expect(pm.response.json().data.marked_read).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark Message Read (missing uid — expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error.code validation_failed', () => pm.expect(pm.response.json().error.code).to.eql('validation_failed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"protocol\": \"imap\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/messages/read",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "messages", "read"]
            },
            "description": "Failure scenario: `uid` is required.\n\nExpected: 400 validation_failed: uid is required."
          }
        }
      ]
    },
    {
      "name": "Folders",
      "item": [
        {
          "name": "List Folders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/folders?protocol=imap",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "folders"],
              "query": [
                { "key": "protocol", "value": "imap", "description": "only imap supports folders (default imap)" }
              ]
            },
            "description": "List IMAP folders (mailboxes) with their delimiter & attributes (e.g. \\Sent).\n\nUse this to learn the CORRECT folder name before fetching — folder names depend on the server/account language (an Indonesian-language Gmail account uses '[Gmail]/Surat Terkirim', not '[Gmail]/Sent Mail'). `accountId` is taken from the environment automatically.\n\nResponse 200: {\"data\":[{\"name\":\"INBOX\",\"delimiter\":\"/\"},{\"name\":\"[Gmail]/Surat Terkirim\",\"delimiter\":\"/\",\"attributes\":[\"\\\\Sent\"]}],\"error\":null}.\nPOP3/SMTP -> 400 validation_failed ('protocol \"pop3\" has no folders')."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors (examples)",
      "item": [
        {
          "name": "Unauthorized (no X-API-Key — expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('error.code unauthorized', () => pm.expect(pm.response.json().error.code).to.eql('unauthorized'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "description": "Request without the X-API-Key header.\n\nExpected: 401 {\"data\":null,\"error\":{\"code\":\"unauthorized\",...}}."
          }
        },
        {
          "name": "Invalid JSON (unknown field — expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error.code invalid_json', () => pm.expect(pm.response.json().error.code).to.eql('invalid_json'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"email\": \"x@example.com\",\n  \"username\": \"x@example.com\",\n  \"password\": \"pw\",\n  \"imap\": { \"host\": \"imap.example.com\", \"port\": 993, \"tls_mode\": \"tls\" },\n  \"unknown_field\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
            "description": "Failure scenario: the body has an unknown field (`unknown_field`). The decoder uses DisallowUnknownFields.\n\nExpected: 400 invalid_json."
          }
        },
        {
          "name": "Not Found (unknown account — expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error.code not_found', () => pm.expect(pm.response.json().error.code).to.eql('not_found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "00000000-0000-0000-0000-000000000000"]
            },
            "description": "Failure scenario: an account id that does not exist.\n\nExpected: 404 not_found."
          }
        }
      ]
    },
    {
      "name": "MCP",
      "item": [
        {
          "name": "initialize",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-06-18\",\n    \"capabilities\": {},\n    \"clientInfo\": { \"name\": \"postman\", \"version\": \"0.0.0\" }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
            "description": "MCP handshake over Streamable HTTP. The Accept header MUST include application/json AND text/event-stream. X-API-Key auth comes from the collection automatically.\n\nIf the response is SSE, the JSON-RPC payload is on the line starting with 'data:'. For real use, use an MCP client (see docs/MCP_CLIENT_GUIDE.md)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));"]
              }
            }
          ]
        },
        {
          "name": "tools/list",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\",\n  \"params\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
            "description": "List MCP tools: list_accounts, send_email, fetch_emails, check_new_emails, list_folders (with their argument JSON schemas)."
          }
        },
        {
          "name": "tools/call → list_accounts",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"method\": \"tools/call\",\n  \"params\": { \"name\": \"list_accounts\", \"arguments\": {} }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
            "description": "Call the list_accounts tool (no arguments). Output: [{id, name, email}] — same as REST GET /accounts, without connection config/credentials."
          }
        },
        {
          "name": "tools/call → fetch_emails",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 4,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"fetch_emails\",\n    \"arguments\": { \"account_id\": \"{{accountId}}\", \"protocol\": \"imap\", \"limit\": 5 }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/mcp", "host": ["{{baseUrl}}"], "path": ["mcp"] },
            "description": "Call the fetch_emails tool. account_id is filled from the `accountId` environment variable.\n\nNote: MCP fetch_emails has no `offset` parameter (REST does)."
          }
        }
      ]
    }
  ]
}
